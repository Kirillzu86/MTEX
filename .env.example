DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret

# Coolify/domains. Examples:
# DJANGO_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
# DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SERVE_MEDIA=True
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# Vite embeds this at build time. Use the public backend API URL in Coolify.
FRONTEND_VITE_API_URL=http://localhost:8000/api
ADMIN_VITE_API_URL=http://localhost:8000/api

# Local docker-compose ports.
BACKEND_PORT=8000
FRONTEND_PORT=5173
ADMIN_FRONTEND_PORT=5174
